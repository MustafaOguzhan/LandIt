{
  "crons": [
    { "path": "/api/cron-trial-feedback", "schedule": "0 9 * * *" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/landit.html" }
  ],
  "headers": [
    {
      "source": "/landit.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
