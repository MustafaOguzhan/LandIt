# Copy this file to .env.local for local development with `vercel dev`.
# In production, set these in Vercel: Project Settings -> Environment Variables.

# AI mock interview - get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Auth + database (Supabase) - Project Settings -> API in your Supabase project.
# SUPABASE_URL and the anon/public key are NOT secret and are hardcoded directly
# in landit.html (see the SUPABASE_URL/SUPABASE_ANON_KEY constants near the end
# of the file) - Supabase's security model relies on Row Level Security, not on
# keeping those two values hidden. Only the values below are actually secret and
# belong in environment variables:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Stripe) - Developers -> API keys, and Developers -> Webhooks for the
# webhook signing secret. STRIPE_PRICE_ID_MONTHLY / STRIPE_PRICE_ID_YEARLY are
# the two recurring Price IDs ($13/mo and $89/yr) under your Product in the
# Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Job search - free account at https://developer.adzuna.com. The dashboard
# gives you both an "Application ID" and "Application Key" immediately.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Churn-feedback emails (Resend) - free account at https://resend.com. Sent to
# a user once when their trial ends without subscribing (api/cron-trial-
# feedback.js, runs daily) and once when a subscription is canceled
# (api/stripe-webhook.js). FEEDBACK_REPLY_TO can be any inbox you actually
# read - replies land there directly, no dashboard needed.
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=
FEEDBACK_REPLY_TO=
# Optional but recommended: protects api/cron-trial-feedback.js so only
# Vercel's own daily cron invocation can trigger it. Vercel automatically
# sends this same value back as a Bearer token when it calls the endpoint.
CRON_SECRET=
